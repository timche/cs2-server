# Game Server Login Token from https://steamcommunity.com/dev/managegameservers
# Without one the server will not appear in the server browser.
SRCDS_TOKEN=

# A "/" in any of these breaks the image's config templating.
CS2_SERVERNAME=CS2
CS2_PW=
CS2_RCONPW=

# The mode to start in before the panel has ever been used: matchzy, retakes or
# chatcontrol. Once the panel has written .control/mode, that file wins and this
# value is ignored.
CS2_MODE=chatcontrol

# Steam64 IDs that get @css/root, comma-separated. Admins edit spawns and use
# !forcebombsite, !scramble and !setnextround in retakes mode. Nobody is an
# admin when empty.
RETAKES_ADMIN_STEAM_IDS=

# CS2_MAXPLAYERS is server slots. In retakes mode, how many of them are in the
# game is retakes' own MaxPlayers (9 by default, 10 at most), and the rest wait
# in the queue.
CS2_PORT=27015
CS2_MAXPLAYERS=12
CS2_STARTMAP=de_dust2

CS2_GAMEALIAS=competitive
# Hibernation has been observed to crash CS2 servers.
CS2_SERVER_HIBERNATE=0
CS2_LOG=off

# MatchZy records match demos through GOTV, so turn this on to keep demos of pug
# matches. TV_AUTORECORD stays off either way: MatchZy starts recording itself.
TV_ENABLE=0
TV_PORT=27020
TV_AUTORECORD=0

# PANEL_PASSWORD is the only thing between whoever reaches the panel and the mode
# switch; PANEL_SECRET signs its login sessions, so changing it logs everyone
# out. PANEL_PORT is the port on 127.0.0.1 and applies only without a tunnel:
# with one, the panel publishes no port at all and cloudflared reaches it over
# the compose network. install.sh writes docker-compose.override.yml to publish
# it, so delete that file to take the port away, or add it to get one back.
PANEL_PORT=8080
PANEL_PASSWORD=
PANEL_SECRET=

# Set this to "tunnel" to start cloudflared alongside the server.
COMPOSE_PROFILES=

# Exempt from the no-slash rule above -- Cloudflare's tokens are base64 and
# contain slashes -- which is safe because the image's sed templating only
# touches the CS2_* and TV_* values.
TUNNEL_TOKEN=

# 1 makes install.sh put a crontab entry on the machine that restarts the game
# container at 06:00 daily, which is when SteamCMD takes a CS2 update and pre.sh
# takes the plugins'. The value records the answer; the schedule itself lives in
# the installing user's crontab.
AUTO_UPDATE=1
